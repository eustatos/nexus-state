{
  "name": "@nexus-state/vue",
  "version": "0.1.8",
  "description": "Vue 3 bindings for @nexus-state/core — composable for atom-based state management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "homepage": "https://nexus-state.website.yandexcloud.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eustatos/nexus-state.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "state-management",
    "vue",
    "vue3",
    "composable",
    "atoms",
    "nexus-state",
    "typescript"
  ],
  "author": "Nexus State Contributors",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@nexus-state/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.7",
    "typescript": "^5.0.0",
    "vitest": "^3.0.7",
    "eslint": "^8.40.0",
    "@vue/reactivity": "^3.3.0",
    "jsdom": "^26.1.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  }
}