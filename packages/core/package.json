{
  "name": "@nexus-state/core",
  "version": "0.2.1",
  "description": "Lightweight, type-safe state management library with atom-based architecture for JavaScript applications",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "sideEffects": false,
  "homepage": "https://nexus-state.website.yandexcloud.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eustatos/nexus-state.git",
    "directory": "packages/core"
  },
  "keywords": [
    "state-management",
    "atoms",
    "reactive",
    "typescript",
    "framework-agnostic",
    "lightweight",
    "type-safe",
    "signals"
  ],
  "author": "Nexus State Contributors",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./batching": {
      "types": "./dist/esm/batching.d.ts",
      "import": "./dist/esm/batching.js"
    },
    "./debug": {
      "types": "./dist/esm/debug.d.ts",
      "import": "./dist/esm/debug.js"
    },
    "./devtools": {
      "types": "./dist/esm/devtools.d.ts",
      "import": "./dist/esm/devtools.js"
    },
    "./reactive": {
      "types": "./dist/esm/reactive.d.ts",
      "import": "./dist/esm/reactive.js"
    },
    "./utils": {
      "types": "./dist/esm/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:esm",
    "build:esm": "tsc -p tsconfig.json",
    "clean": "rm -rf dist && mkdir dist",
    "dev": "tsc -w",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "lint": "eslint . --ext .ts",
    "bundle:measure": "node measure-bundles.mjs",
    "bundle:verify": "node verify-treeshake.mjs"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/test-utils",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.0.7"
  }
}